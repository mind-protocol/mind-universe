{
  "assetKind": "city_layout_policy",
  "version": 0,
  "provenance": "Authored desktop-city projection policy. Extracted verbatim from the former hardcoded districtOf()/DISTRICT_STYLE maps in materialize-city.mjs so the build script embeds no ontology-specific placement policy nor privileged per-kind visual metaphor (CLAUDE.md: native/bootstrap code must not contain 'a generated semantic layout for a city' nor 'one privileged visual interpretation of a semantic type or predicate'). This file is DATA, not code: attributable, versioned, replaceable. It is a desktop-only view policy; the store carries no district asset yet, so it may later be superseded by a graph-native spatial-layout Asset without touching the projector.",
  "default_district": "outskirts",
  "district_order": [
    "civic", "canon", "code", "physics", "mapping",
    "governance", "schema", "acoustic", "contract", "outskirts"
  ],
  "rules": [
    { "district": "acoustic",   "includes": ["audio", "acoustic"] },
    { "district": "physics",    "includes": ["physical_profile"] },
    { "district": "canon",      "startsWith": ["ontology_"] },
    { "district": "code",       "includes": ["code"] },
    { "district": "schema",     "includes": ["data_contract", "schema"] },
    { "district": "mapping",    "includes": ["visual_mapping", "_mapping"], "equals": ["mapping"] },
    { "district": "contract",   "includes": ["contract"] },
    { "district": "governance", "includes": ["validation", "metric", "health", "gap", "task", "receipt", "changeset", "outcome", "problem"] },
    { "district": "civic",      "includes": ["loop", "objective", "pattern", "policy"], "equals": ["space"] }
  ],
  "styles": {
    "civic":      { "color": "#6fa8ff", "primitive": "bounded_volume",             "motion": "boundary_breath", "scale": 1.05 },
    "canon":      { "color": "#9b8fb0", "primitive": "open_polyhedral_attractor",  "motion": "still",           "scale": 0.5 },
    "code":       { "color": "#c68adf", "primitive": "faceted_router",             "motion": "port_transform",  "scale": 0.72 },
    "physics":    { "color": "#d86a5a", "primitive": "torus_knot",                 "motion": "still",           "scale": 0.55 },
    "mapping":    { "color": "#3fb7c9", "primitive": "oriented_ring",              "motion": "inward_orbit",    "scale": 0.7 },
    "governance": { "color": "#66c07a", "primitive": "pulsing_core",               "motion": "outward_pulse",   "scale": 0.66 },
    "schema":     { "color": "#8fd6ff", "primitive": "cylinder",                   "motion": "still",           "scale": 0.7 },
    "acoustic":   { "color": "#f0c674", "primitive": "tetrahedron",                "motion": "still",           "scale": 0.62 },
    "contract":   { "color": "#e0a24a", "primitive": "slab",                       "motion": "still",           "scale": 0.72 },
    "outskirts":  { "color": "#5a616e", "primitive": "unknown",                    "motion": "still",           "scale": 0.6 }
  }
}
