{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mind Universe",
  "version": "0.1.0",
  "identifier": "universe.mind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mind Universe",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "fullscreen": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
