    "contractKind": "construct",
    "name": "Lumina Prime Orientation Beacon v0",
    "parent_scope": {
      "classification": "contained",
      "parent_space": "space:l2:lumina-prime:city-v0",
      "justification": "The beacon is a unique civic infrastructure loop structurally contained by Lumina Prime."
    },
    "runtime_moment_subtypes": [
      "validation_run",
      "health_assessment"
    ],
    "native_law_boundary": "AtomDynamics remains ontology-blind and knows only AtomSpec, AtomBond and support/inhibit/neutral. Location, quadrant, distance, city identity and emergency semantics are typed payload data transformed by Things.",
    "normal_modes": [
      "zone_entry",
      "explicit_locate",
      "sector_change"
    ],
    "emergency_port": {
      "port_id": "port:l2:lumina-prime:orientation-beacon:emergency-broadcast-v0",
      "accepted_target_subtype": "emergency_broadcast_authorization",
      "accepted_relations": [
        "USES",
        "DEPENDS_ON"
      ],
      "default_state": "unlinked",
      "rule": "An unlinked port cannot broadcast. A linked node arms the branch only when its identity, authority, scope, message, freshness and non-supersession are measured."
    }
  },
  "members": [
    {
      "id": "objective:l2:lumina-prime:orientation-beacon-v0",
      "node_type": "narrative",
      "subtype": "objective",
      "content": {
        "success_condition": "For each fresh admitted orientation trigger, exactly one situated_orientation stimulus is delivered to the addressed Citizen with the exact city identity, quadrant, grid sector, signed east/north offsets and integer ground distance derived from fresh position evidence. Missing or stale evidence remains explicit. Emergency broadcast occurs only through a valid linked authorization node."
      }
    },
    {
      "id": "pattern:l2:lumina-prime:construct-gps-beacon-v0",
      "node_type": "narrative",
      "subtype": "pattern",
      "content": {
        "pattern": "A persistent Built civic beacon contains two bounded atom circuits: (1) a normal situated-orientation gate and (2) an optional emergency-broadcast gate. Energy only gates evidence flow; a deterministic spatial resolver computes location from integer poses. An independent observer recomputes the fix, validates the event ledger and delivery receipts, then derives a health vector from fresh evidence."
      }
    },
    {
      "id": "vocabulary:l2:lumina-prime:orientation-beacon-v0",
      "node_type": "narrative",
      "subtype": "vocabulary",
      "content": {
        "terms": {
          "BuiltPose": "Persistent authored construction pose of the beacon. It is observed from the canonical Universe and has precedence over Derived or generated layout.",
          "CitizenPose": "Fresh measured Citizen pose in the Lumina Prime civic coordinate frame.",
          "CoordinateFrame": {
            "origin": "BuiltPose of Balise Zéro",
            "east_axis": "+X",
            "north_axis": "+Z",
            "up_axis": "+Y",
            "unit": "millimetre integers"
          },
          "SpatialFix": [
            "city_id",
            "city_name",
            "coordinate_frame_id",
            "east_mm",
            "north_mm",
            "elevation_mm",
            "distance_ground_mm",
            "quadrant",
            "sector_id",
            "source_beacon_id",
            "position_status",
            "observed_at",
            "valid_until"
          ],
          "Quadrant": [
            "CENTER",
            "NE",
            "NW",
            "SE",
            "SW"
          ],
          "OrientationTrigger": [
            "zone_entry",
            "explicit_locate",
            "sector_change"
          ],
          "SituatedOrientation": "Typed local stimulus carrying a machine-readable SpatialFix and a concise human-readable orientation message.",
          "EmergencyBroadcastAuthorization": "A separately linked construct authority node defining issuer, severity, message, affected zones, validity window, repetition and acknowledgement policy.",
          "Fog": "Unknown, not_measured or rejected position/energy evidence. Never rendered as a precise fix.",
          "EntryToken": "Unique token preventing more than one normal emission for the same trigger event."
        }
      }
    },
    {
      "id": "behavior:l2:lumina-prime:orientation-beacon-v0",
      "node_type": "narrative",
      "subtype": "behavior",
      "content": {
        "given": "A Built beacon pose, a fresh measured Citizen pose, a unique admitted trigger token, an observed Lumina Prime identity, an admitted emission policy, and measured atom energy.",
        "when": "A Citizen enters the beacon zone, explicitly requests location, crosses a sector boundary, or a valid linked emergency authorization becomes active.",
        "then": [
          "Recompute signed east/north offsets in integer millimetres.",
          "Compute integer ground distance with an integer square root.",
          "Derive quadrant and sector from the civic coordinate frame.",
          "Emit at most one typed situated_orientation stimulus per normal trigger token.",
          "Produce delivery and emission-ledger receipts.",
          "Run the independent observer and structured evaluation AST.",
          "Produce fresh validation_run and health_assessment moments."
        ],
        "forbidden": [
          "inventing a quadrant, sector, bearing or distance when position evidence is absent",
          "using camera pose, embeddings or generated layout as civic position authority",
          "overwriting a Built beacon pose with Derived or generated coordinates",
          "encoding distance or semantic meaning as atom energy",
          "streaming authored, derived, unknown or not_measured bond energy",
          "emitting twice for one EntryToken",
          "claiming delivery from renderer animation or an emitter process that merely runs",
          "broadcasting emergency content without an exact valid linked authorization node",
          "broadcasting outside the measured affected zone",
          "pre-creating validation_run or health_assessment",
          "converting stale, unknown, not_measured or measurement_failed evidence into success"
        ]
      }
    },
    {
      "id": "algorithm:l2:lumina-prime:orientation-beacon-v0",
      "node_type": "narrative",
      "subtype": "algorithm",
      "content": {
        "steps": [
          "resolve the unique parent city Space and exact beacon BuiltPose",
          "observe the exact city identity and civic coordinate frame",
          "admit a fresh trigger token and measured Citizen pose through the membrane",
          "preserve unknown, not_measured, stale and measurement_failed without substitution",
          "compute dx = citizen.x - beacon.x and dz = citizen.z - beacon.z using signed integers",
          "compute distance_ground_mm = isqrt(dx*dx + dz*dz)",
          "derive CENTER when distance_ground_mm <= center_radius_mm; otherwise derive quadrant from signs of dx and dz",
          "derive sector_id from floor-divided east/north grid coordinates using deterministic signed integer rules",
          "assemble a typed SpatialFix with source and freshness metadata",
          "run the normal atom circuit until quiescence",
          "emit exactly one situated_orientation stimulus if and only if the orientation gate fires",
          "persist delivery_receipt and emission_ledger receipt",
          "when the emergency port is linked, independently validate the target authorization loop",
          "run the emergency atom circuit only when authority, message, scope, freshness, zone match and non-supersession are measured",
          "run an independent observer over source evidence, atom ledgers, payloads and receipts",
          "evaluate the canonical structured AST",
          "derive health from fresh measured dimensions"
        ],
        "spatial_rules": {
          "integer_only": true,
          "distance": "ground-plane Euclidean distance via deterministic integer square root",
          "quadrant_axes": {
            "east": "+X",
            "north": "+Z"
          },
          "center_radius_mm": 5000,
          "sector_size_mm": 100000,
          "sector_encoding": "signed grid cell relative to Balise Zéro, rendered as E{east_cell}:N{north_cell}"
        },
        "epistemic_precedence": [
          "Built",
          "Observed",
          "Measured",
          "Derived",
          "Unknown"
        ],
        "evaluation": "structured_expression_ast",
        "python_escape_hatch": "forbidden_by_default"
      }
    },
