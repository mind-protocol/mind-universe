      "key": "00000000000000000000000000003103",
      "symbol": "design_rationale",
      "content": {
        "kind": "loop_pattern",
        "canonical_id": "repeat-until-limit.pattern",
        "principle": "Bounded backward control transfer. The only permitted backward edge (loop_next) is gated by a measured boolean condition and charged against an explicit iteration budget, on top of per-traversal fuel, giving two independent liveness guarantees.",
        "status": "active"
      }
    },
    {
      "key": "00000000000000000000000000003104",
      "symbol": "narrative",
      "content": {
        "kind": "loop_vocabulary",
        "canonical_id": "repeat-until-limit.vocabulary",
        "terms": {
          "condition": "a Register holding a strictly boolean epistemic value; non-boolean or non-measured states are not accepted",
          "loop_next": "operator index taken when condition is false (the single permitted backward target)",
          "exit_next": "operator index taken when condition is true (forward exit)",
          "max_iterations": "graph-data iteration budget; zero or absent is rejected at validation",
          "trap": "deterministic halt with error, distinct from a normal exit"
        },
        "status": "active"
      }
    },
    {
      "key": "00000000000000000000000000003105",
      "symbol": "narrative",
      "content": {
        "kind": "loop_behavior",
        "canonical_id": "repeat-until-limit.behavior",
        "given": "a RepeatUntilWithLimit operator with condition register c, loop_next L, exit_next E, and max_iterations N > 0",
        "when": "the operator is traversed",
        "then": [
          "if c is Measured(true): transfer control to E (forward exit)",
          "if c is Measured(false) and charged_iterations < N: charge one iteration and transfer control to L (backward)",
          "if c is Measured(false) and charging would reach or exceed N: trap",
          "if c is Unknown/KnownAbsent/NotMeasured/MeasurementFailed: trap",
          "every traversal consumes one unit of fuel"
        ],
        "forbidden": ["silent exit on budget exhaustion", "reading a non-boolean condition as continue or stop", "unbounded backward looping"],
        "status": "active"
      }
    },
    {
      "key": "00000000000000000000000000003106",
      "symbol": "narrative",
      "content": {
        "kind": "loop_algorithm",
        "canonical_id": "repeat-until-limit.algorithm",
        "steps": [
          "read condition register c",
          "if c is not Measured(bool) -> trap (preserve epistemic distinction)",
          "if c == true -> goto exit_next",
          "if charged_iterations + 1 > max_iterations -> trap",
          "charged_iterations += 1",
          "goto loop_next"
        ],
        "preserves": ["unknown", "not_measured", "measurement_failed"],
        "status": "active"
      }
    },
